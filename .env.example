APP_NAME=FinMate
APP_TAGLINE=Your Money. Smarter.
APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./data/finmate.db
# For AWS RDS Postgres, use instead (never commit the real value):
# DATABASE_URL=postgresql+psycopg2://<master_username>:<master_password>@<rds-endpoint>:5432/<db_name>

SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI_PROVIDER: none | mock | openai | anthropic | gemini | local
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

CORS_ORIGINS=http://localhost:5173
